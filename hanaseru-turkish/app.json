{
  "expo": {
    "name": "話せるトルコ語",
    "slug": "hanaseru-turkish",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "hanaseru-turkish",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E30A17"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hanaseruturkish.app",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "話せるトルコ語",
        "CFBundleDevelopmentRegion": "ja",
        "CFBundleLocalizations": [
          "ja"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": []
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E30A17"
      },
      "package": "com.hanaseruturkish.app"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "your-project-id-here"
      }
    }
  }
}